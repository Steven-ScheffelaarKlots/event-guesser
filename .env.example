# Copy to .env to override. These are the defaults the API uses without a .env.
DATABASE_URL=postgres://chronodle:chronodle@localhost:5434/chronodle
TEST_DATABASE_URL=postgres://chronodle:chronodle@localhost:5434/chronodle_test
PORT=3000
# Set to 0.0.0.0 to expose the API on your network. The admin has no login.
HOST=127.0.0.1
